{
    "name": "@skillnavi/service",
    "version": "1.0.1",
    "private": true,
    "scripts": {
        "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
        "dev": "env-cmd -f .env.dev pnpm run prisma:generate && env-cmd -f .env.dev next dev --turbopack -p 3000",
        "build:dev": "env-cmd -f .env.dev pnpm run prisma:generate && env-cmd -f .env.dev next build",
        "build": "env-cmd -f .env.prd pnpm run prisma:generate && env-cmd -f .env.prd next build",
        "start:dev": "env-cmd -f .env.dev next start",
        "start": "env-cmd -f .env.prd next start",
        "lint": "next lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@aws-sdk/client-ssm": "^3.1162.0",
        "@fortawesome/fontawesome-svg-core": "catalog:",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "catalog:",
        "@fortawesome/react-fontawesome": "catalog:",
        "@lottiefiles/dotlottie-react": "^0.13.2",
        "@prisma/client": "6.19.1",
        "@react-oauth/google": "^0.13.5",
        "@skillnavi/data": "workspace:*",
        "@skillnavi/ui": "workspace:*",
        "@tanstack/react-query": "catalog:",
        "cheerio": "catalog:",
        "clsx": "catalog:",
        "dayjs": "^1.11.13",
        "env-cmd": "^10.1.0",
        "google-auth-library": "^11.3.3",
        "html2canvas-pro": "^2.0.2",
        "jotai": "catalog:",
        "js-sha256": "^0.11.0",
        "lodash": "^4.17.23",
        "mariadb": "^3.5.4",
        "nanoid": "^5.1.16",
        "next": "^15.5.29",
        "next-intl": "^4.1.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "recharts": "^3.10.1",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@skillnavi/tsconfig": "workspace:*",
        "@tailwindcss/postcss": "catalog:",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@testing-library/user-event": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "jsdom": "^29.1.1",
        "postcss": "catalog:",
        "prisma": "6.19.1",
        "tailwind-merge": "^2.5.3",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vite-tsconfig-paths": "catalog:",
        "vitest": "catalog:"
    },
    "overrides": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0"
    }
}
